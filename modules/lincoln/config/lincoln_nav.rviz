Panels:
- Class: rviz_common/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
  Tree Height: 414
- Class: rviz_common/Views
  Expanded: null
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Lincoln body and rotating wheels
    Namespaces:
      lincoln_f5c9033aa2: true
      lincoln_f5c9033aa2_wheels: true
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /lincoln_f5c9033aa2/navigation/vehicle
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: CARLA lane markings
    Namespaces:
      carla_map: true
      carla_road_geometry: true
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /lincoln_f5c9033aa2/roads
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Navigation lane and arrows
    Namespaces:
      navigation_lane: true
      navigation_arrows: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /lincoln_f5c9033aa2/navigation/route
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: TM action preview - red straight segments
    Namespaces:
      tm_action_path: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /lincoln_f5c9033aa2/navigation/tm_path
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 60
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Distance: 15
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: -3.841458320617676
        Y: -0.25203558802604675
        Z: 0.9999985694885254
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.05000000074505806
      Pitch: 0.22500017285346985
      Target Frame: lincoln_f5c9033aa2/base_link
      Value: ThirdPersonFollower (rviz_default_plugins)
      Yaw: 3.1500003337860107
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Height: 800
  Width: 1100
  X: 80
  Y: 80
  Hide Left Dock: false
  Hide Right Dock: false
